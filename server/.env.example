# Copy this file to server/.env (git-ignored) and fill in real values.
# Each PC needs its own server/.env — it is never committed or synced via git.

# Neon Postgres connection string for the DEV branch (never the production
# branch — see the Persistence plan's "Claude's ability to inspect/edit the
# live database" section). Found in the Neon console under your project's
# Connection Details for the "dev" branch. Looks like:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# A long random shared secret, the same value on both PCs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Optional — defaults to 8787 if not set.
PORT=8787
